# =========================
# Server
# =========================
# 后端 HTTP 端口。
PORT=3001

# JSON 请求体大小上限，单位 byte。用于 /api/chat 等 JSON 接口。
# 文件上传接口使用 multipart 的 fileSize 限制，不受这个值控制。
BODY_LIMIT_BYTES=4194304

# 可选的全局业务接口密钥。为空时聊天、上传、检索等接口开放；设置后这些非公开接口需要鉴权。
API_KEY=

# 允许访问后端的前端地址，多个地址用英文逗号分隔。
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173


# =========================
# Chat Providers
# =========================
# Ollama 服务地址。Windows 下如果 localhost 有 IPv4/IPv6 差异，可改为 http://127.0.0.1:11434。
OLLAMA_URL=http://localhost:11434

# 默认本地对话模型。/api/chat 未显式传 model 时使用。
DEFAULT_MODEL=qwen3:8b

# Ollama 请求超时时间，单位 ms。本地大模型或视觉模型较慢时需要更大值。
OLLAMA_TIMEOUT_MS=600000

# OpenAI 官方或兼容接口配置。
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_DEFAULT_MODEL=gpt-4o

# Anthropic Claude 配置。
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_DEFAULT_MODEL=claude-sonnet-4-5


# =========================
# RAG Retrieval
# =========================
# embedding 模型。中文知识库建议使用 bge-m3；默认值适合 Ollama 本地快速启动。
EMBEDDING_MODEL=nomic-embed-text

# RAG 模式：auto 自动判断，true 强制启用，false 关闭。兼容旧变量 RAG_ENABLED。
RAG_MODE=auto

# 是否在模型回答正文中显示“[文件名 chunk 编号]”引用标记。当前项目用于本地调试，生产环境建议设为 false。
# 关闭只影响引用标记展示，不会关闭知识库检索、来源材料注入或 /api/chat/context 的 results。
RAG_SHOW_CITATIONS=true

# 默认返回 chunk 数，代码会限制在 1-20。
RAG_TOP_K=5

# 默认最低综合分数。当前推荐值来自本项目 RAG 回归测试。
RAG_MIN_SCORE=0.6

# 混合检索权重：综合分 = 向量分 * RAG_VECTOR_WEIGHT + 关键词分 * RAG_KEYWORD_WEIGHT。
RAG_VECTOR_WEIGHT=0.8
RAG_KEYWORD_WEIGHT=0.2

# SQLite 本地向量检索候选数量上限。文件多时可适当调大。
RAG_VECTOR_CANDIDATE_LIMIT=1000


# =========================
# Upload And Chunking
# =========================
# 单个 chunk 的最大字符数，代码会限制在 100-3000。
CHUNK_MAX_LEN=700

# 相邻 chunk 的重叠字符数，代码会限制小于 CHUNK_MAX_LEN。
CHUNK_OVERLAP=100

# 文件解析后文本总字符数上限，超过会拒绝入库，避免超大文本拖垮切块和 embedding。
MAX_EXTRACTED_TEXT_CHARS=2000000

# 单文件最多允许生成的 chunk 数，代码会限制在 1-5000。
MAX_FILE_CHUNKS=2000

# embedding 批处理大小。调大可减少请求次数，但会增加单次请求压力。
EMBEDDING_BATCH_SIZE=16

# 图片入库时使用的视觉模型。
VISION_MODEL=qwen3-vl:2b

# 上传原图保存目录，仅图片入库会保存源文件。
UPLOAD_DIR=server/data/uploads


# =========================
# Vector Store
# =========================
# SQLite 元数据和本地向量库文件路径。
VECTOR_STORE_PATH=server/data/vector-store.sqlite

# 向量后端：sqlite 或 qdrant。默认 sqlite，适合本地开发。
VECTOR_BACKEND=sqlite

# Qdrant 配置。仅当 VECTOR_BACKEND=qdrant 时使用。
QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=knowledge_chunks
QDRANT_DISTANCE=Cosine

# 预留租户/项目/用户字段，后续接权限或多项目检索时使用。
DEFAULT_TENANT_ID=default
DEFAULT_PROJECT_ID=default
DEFAULT_OWNER_USER_ID=local


# =========================
# Observability And Logs
# =========================
# 独立观测数据库。不能与 VECTOR_STORE_PATH 相同。
OBSERVABILITY_DB_PATH=server/data/observability.sqlite

# Pino 控制台日志级别：fatal/error/warn/info/debug/trace/silent。
LOG_LEVEL=info

# 是否开放日志查询接口和 Dashboard。开启时还必须配置 LOG_QUERY_API_KEY。
LOG_QUERY_ENABLED=false

# 日志查询和 Dashboard 专用密钥，不影响聊天、上传等业务接口。
LOG_QUERY_API_KEY=

# 是否保存用户问题前 200 个字符。默认关闭，避免记录敏感内容。
LOG_QUESTION_PREVIEW=false

# IP 记录策略：none 不记录、masked 掩码、full 完整记录。
LOG_REMOTE_ADDRESS=none

# 日志队列上限。队列满时固定丢弃最旧记录，优先保留最新故障现场。
LOG_QUEUE_MAX_SIZE=5000

# 批量写入间隔和失败后的最大延迟重试次数。
LOG_FLUSH_INTERVAL_MS=5000
LOG_WRITE_RETRY_COUNT=3

# application_events 的白名单 contextJson 最大字符数。
LOG_CONTEXT_MAX_CHARS=2000

# 三类结构化日志的保留天数，每日独立清理。
LOG_HTTP_RETENTION_DAYS=30
LOG_AI_RETENTION_DAYS=90
LOG_EVENT_RETENTION_DAYS=90

# 可选。覆盖模型价格表，格式：
# provider:model:inputPer1kTokens:outputPer1kTokens,...
# 示例：openai:gpt-4o:0.005:0.02,anthropic:claude-sonnet-4-5:0.006:0.03
PRICING_TABLE=


# =========================
# Agent V0
# =========================
# Agent 默认关闭。V0 仅支持后端 Ollama + calculator，不影响现有 /api/chat。
AGENT_ENABLED=false

# api-key：要求 x-agent-api-key；loopback：仅允许后端直接收到的本机地址。
# 前端通过 Vite 代理访问时建议使用 api-key，不能依赖 loopback 作为局域网鉴权。
AGENT_ACCESS_MODE=api-key
AGENT_API_KEY=

# Agent 允许使用的 Ollama 模型白名单，逗号分隔。
AGENT_OLLAMA_MODELS=qwen2.5:7b

# 是否启用 Ollama Agent 模型的思考模式。开启后可能改善复杂推理，但会增加响应耗时；原始思考内容不会返回前端。
AGENT_OLLAMA_THINKING_ENABLED=false

# 用户未明确提供时区时，日期时间工具使用的 IANA 默认时区。
AGENT_DEFAULT_TIME_ZONE=Asia/Shanghai

# Ollama 模型调用并发固定为 1；等待队列默认最多 5 个请求。
AGENT_QUEUE_MAX_SIZE=5
AGENT_QUEUE_TIMEOUT_MS=30000

# 单次 Ollama 模型调用 10 分钟，整次 Agent 最多 20 分钟。
AGENT_OLLAMA_MODEL_TIMEOUT_MS=600000
AGENT_RUN_TIMEOUT_MS=1200000
AGENT_CONNECT_TIMEOUT_MS=15000
AGENT_STREAM_IDLE_TIMEOUT_MS=180000
AGENT_HEARTBEAT_INTERVAL_MS=15000

# 工具超时和返回给模型的文本长度上限。
AGENT_TOOL_TIMEOUT_MS=5000
AGENT_TOOL_RESULT_MAX_CHARS=4000

# 调试时可在 tool_completed 事件中返回脱敏、截断后的工具结果；生产环境保持 false。
AGENT_DEBUG_TOOL_RESULTS=false
AGENT_DEBUG_TOOL_RESULT_MAX_CHARS=2000
