OLLAMA_URL=http://localhost:11434
DEFAULT_MODEL=qwen3:8b
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_DEFAULT_MODEL=gpt-4o
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_DEFAULT_MODEL=claude-sonnet-4-5
PORT=3001

# Max JSON request body size in bytes. Multipart upload uses its own fileSize limit.
BODY_LIMIT_BYTES=4194304

# Optional. When set, all non-public APIs require x-api-key or Authorization: Bearer.
API_KEY=

# Comma-separated allowed browser origins.
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000

EMBEDDING_MODEL=nomic-embed-text
RAG_MODE=auto
RAG_TOP_K=5
RAG_MIN_SCORE=0.55
RAG_VECTOR_WEIGHT=0.8
RAG_KEYWORD_WEIGHT=0.2
RAG_VECTOR_CANDIDATE_LIMIT=1000

CHUNK_MAX_LEN=700
CHUNK_OVERLAP=100
EMBEDDING_BATCH_SIZE=16
OLLAMA_TIMEOUT_MS=900000
VISION_MODEL=qwen3-vl:2b
UPLOAD_DIR=server/data/uploads

VECTOR_STORE_PATH=server/data/vector-store.sqlite
VECTOR_BACKEND=sqlite

# Qdrant is optional and only used when VECTOR_BACKEND=qdrant.
QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=knowledge_chunks
QDRANT_DISTANCE=Cosine
DEFAULT_TENANT_ID=default
DEFAULT_PROJECT_ID=default
DEFAULT_OWNER_USER_ID=local

# Metrics
METRICS_RETENTION_DAYS=30
# Optional. Override pricing: provider:model:inputPer1kTokens:outputPer1kTokens,...
# Example: PRICING_TABLE=openai:gpt-4o:0.005:0.02,anthropic:claude-sonnet-4-5:0.006:0.03
PRICING_TABLE=
