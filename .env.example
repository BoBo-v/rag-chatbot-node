# =========================
# Server
# =========================
# 后端 HTTP 端口。
PORT=3001

# JSON 请求体大小上限，单位 byte。用于 /api/chat 等 JSON 接口。
# 文件上传接口使用 multipart 的 fileSize 限制，不受这个值控制。
BODY_LIMIT_BYTES=4194304

# 可选。为空时接口默认开放；设置后，非公开接口需要 x-api-key 或 Authorization: Bearer。
API_KEY=

# 允许访问后端的前端地址，多个地址用英文逗号分隔。
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173


# =========================
# Chat Providers
# =========================
# Ollama 服务地址。Windows 下如果 localhost 有 IPv4/IPv6 差异，可改为 http://127.0.0.1:11434。
OLLAMA_URL=http://localhost:11434

# 默认本地对话模型。/api/chat 未显式传 model 时使用。
DEFAULT_MODEL=qwen3:8b

# Ollama 请求超时时间，单位 ms。本地大模型或视觉模型较慢时需要更大值。
OLLAMA_TIMEOUT_MS=900000

# OpenAI 官方或兼容接口配置。
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_DEFAULT_MODEL=gpt-4o

# Anthropic Claude 配置。
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_DEFAULT_MODEL=claude-sonnet-4-5


# =========================
# RAG Retrieval
# =========================
# embedding 模型。中文知识库建议使用 bge-m3；默认值适合 Ollama 本地快速启动。
EMBEDDING_MODEL=nomic-embed-text

# RAG 模式：auto 自动判断，true 强制启用，false 关闭。兼容旧变量 RAG_ENABLED。
RAG_MODE=auto

# 是否在模型回答正文中显示“[文件名 chunk 编号]”引用标记。当前项目用于本地调试，生产环境建议设为 false。
# 关闭只影响引用标记展示，不会关闭知识库检索、来源材料注入或 /api/chat/context 的 results。
RAG_SHOW_CITATIONS=true

# 默认返回 chunk 数，代码会限制在 1-20。
RAG_TOP_K=5

# 默认最低综合分数。当前推荐值来自本项目 RAG 回归测试。
RAG_MIN_SCORE=0.6

# 混合检索权重：综合分 = 向量分 * RAG_VECTOR_WEIGHT + 关键词分 * RAG_KEYWORD_WEIGHT。
RAG_VECTOR_WEIGHT=0.8
RAG_KEYWORD_WEIGHT=0.2

# SQLite 本地向量检索候选数量上限。文件多时可适当调大。
RAG_VECTOR_CANDIDATE_LIMIT=1000


# =========================
# Upload And Chunking
# =========================
# 单个 chunk 的最大字符数，代码会限制在 100-3000。
CHUNK_MAX_LEN=700

# 相邻 chunk 的重叠字符数，代码会限制小于 CHUNK_MAX_LEN。
CHUNK_OVERLAP=100

# 文件解析后文本总字符数上限，超过会拒绝入库，避免超大文本拖垮切块和 embedding。
MAX_EXTRACTED_TEXT_CHARS=2000000

# 单文件最多允许生成的 chunk 数，代码会限制在 1-5000。
MAX_FILE_CHUNKS=2000

# embedding 批处理大小。调大可减少请求次数，但会增加单次请求压力。
EMBEDDING_BATCH_SIZE=16

# 图片入库时使用的视觉模型。
VISION_MODEL=qwen3-vl:2b

# 上传原图保存目录，仅图片入库会保存源文件。
UPLOAD_DIR=server/data/uploads


# =========================
# Vector Store
# =========================
# SQLite 元数据和本地向量库文件路径。
VECTOR_STORE_PATH=server/data/vector-store.sqlite

# 向量后端：sqlite 或 qdrant。默认 sqlite，适合本地开发。
VECTOR_BACKEND=sqlite

# Qdrant 配置。仅当 VECTOR_BACKEND=qdrant 时使用。
QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=knowledge_chunks
QDRANT_DISTANCE=Cosine

# 预留租户/项目/用户字段，后续接权限或多项目检索时使用。
DEFAULT_TENANT_ID=default
DEFAULT_PROJECT_ID=default
DEFAULT_OWNER_USER_ID=local


# =========================
# Metrics
# =========================
# 指标保留天数。
METRICS_RETENTION_DAYS=30

# 可选。覆盖模型价格表，格式：
# provider:model:inputPer1kTokens:outputPer1kTokens,...
# 示例：openai:gpt-4o:0.005:0.02,anthropic:claude-sonnet-4-5:0.006:0.03
PRICING_TABLE=
